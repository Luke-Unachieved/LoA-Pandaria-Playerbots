+  else if(!Enabled()||m->GetSpawnMode()!=3||!g->isRaidGroup())return false;
+  ShadowCollectorV18::NativeFacts f={};
+  f.kind=dungeon?EngineShadowV17::DungeonMapSession:EngineShadowV17::SupportedRaidEncounter;
+  // Enumerate only the owning map's native player list. Never resolve or
+  // dereference another map's member through a global player accessor.
+  unsigned scanned=0;
+  for(auto const& ref:m->GetPlayers()) {
+   if(++scanned>64)return false;
+   auto member=ref.GetSource();if(!member||member->GetGroup()!=g)continue;
+   auto memberAI=GET_PLAYERBOT_AI(member);
+   if(f.memberCount>=10||!member->GetSession()||!member->GetSession()->IsBot()||
+      member->GetSession()->isLogingOut()||!memberAI||memberAI->IsRealPlayer()||
+      memberAI->GetBot()!=member||!member->IsInWorld()||member->IsDuringRemoveFromWorld()||
+      member->IsBeingTeleported()||member->IsCharmed()||member->GetMap()!=m)return false;
+   f.members[f.memberCount++]=member->GetGUID().GetRawValue();
+  }
+  // Includes all native group slots: absent/offline/other-map members fail closed.
+  if(f.memberCount!=g->GetMembersCount())return false;

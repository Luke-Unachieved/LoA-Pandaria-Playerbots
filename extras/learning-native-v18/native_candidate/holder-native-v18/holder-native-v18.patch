+// Scoped fix for sessions acquired by this managed path. The legacy generic logout
+// erases the holder before its hook and does not reliably erase the central AI map.
+// Never apply this receipt path to a human, ordinary bot, or replacement session.
+bool PlayerbotHolder::HasManagedSession(ObjectGuid guid, uint64 sessionReceipt) const
+{
+    // World-thread only, same ownership as managedSessions and managed callbacks.
+    auto it = managedSessions.find(guid);
+    if (!sessionReceipt || it == managedSessions.end() || it->second.serial != sessionReceipt) return false;
+    Player* bot = GetPlayerBot(guid);
+    return bot && bot->GetSession() == it->second.session && bot->GetSession()->IsBot() && IsRaidOwnedBot(guid);
+}
+
+bool PlayerbotHolder::FinishManagedBot(Player* bot, bool logoutSession, uint64 receipt, bool requireUnjoined)
+{
+    if (!bot || !bot->GetSession() || !bot->GetSession()->IsBot()) return false;
+    ObjectGuid guid = bot->GetGUID();
+    auto it = managedSessions.find(guid);
+    PlayerbotAI* ai = GET_PLAYERBOT_AI(bot);
+    if (it == managedSessions.end() || it->second.session != bot->GetSession() ||
+        (receipt && receipt != it->second.serial) || !ai || ai->IsRealPlayer() ||
+        GetPlayerBot(guid) != bot || !IsRaidOwnedBot(guid)) return false;
+    if (requireUnjoined && (ai->GetMaster() || bot->GetGroup() || bot->GetOriginalGroup() || bot->GetGroupInvite()))
+        return false;
+    WorldSession* session = bot->GetSession();
+    managedSessions.erase(it);
+    { std::unique_lock<std::shared_mutex> guard(playerBotsMutex); playerBots.erase(guid); }
+    sPlayerbotsMgr->RemovePlayerBotData(guid, true);
+    delete ai; // Releases raid/pet state while Player is still valid.
+    if (logoutSession)
+    {
+        session->LogoutPlayer(true); // Normal persistence; the logout hook now sees no owned AI.
+        delete session;
+    }
+    return true;
+}
+
+bool PlayerbotHolder::LogoutUnjoinedManagedBot(ObjectGuid guid, uint64 receipt)
+{
+    return receipt && FinishManagedBot(GetPlayerBot(guid), true, receipt, true);
+}

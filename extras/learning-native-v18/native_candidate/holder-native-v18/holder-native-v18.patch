+std::shared_ptr<BotLoginLease> AcquireBotLoginLease(ObjectGuid guid, std::shared_ptr<ManagedBotLogin> const& managed)
+{
+    std::lock_guard<std::mutex> lock(botLoginLeaseMutex);
+    // Remove completed entries so the registry cannot grow with historical GUIDs.
+    for (auto i = botLoginLeases.begin(); i != botLoginLeases.end();)
+        if (i->second.expired()) i = botLoginLeases.erase(i); else ++i;
+    if (botLoginLeases.count(guid)) return {};
+    auto lease = std::make_shared<BotLoginLease>();
+    lease->guid = guid; lease->managed = managed;
+    botLoginLeases.emplace(guid, lease);
+    return lease;
+}
+bool ManagedValid(std::shared_ptr<ManagedBotLogin> const& token)
+{
+    return token && !token->cancelled.load() && token->valid && token->valid();
+}

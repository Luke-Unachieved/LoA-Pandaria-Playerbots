+
+bool PlayerbotHolder::IsRaidProvisioningAccount(uint32 accountId)
+{
+    // Startup configuration: changing this allowlist requires a restart. No credentials.
+    static std::set<uint32> const accounts = []
+    {
+        std::set<uint32> result;
+        std::string text = sConfigMgr->GetStringDefault("AiPlayerbot.MopRaidRecruitment.ProvisioningAccounts", "");
+        std::replace(text.begin(), text.end(), ',', ' ');
+        std::istringstream input(text); std::string word;
+        while (input >> word)
+        {
+            if (word.empty() || word.find_first_not_of("0123456789") != std::string::npos) continue;
+            try { unsigned long long value = std::stoull(word); if (value && value <= 0xffffffffULL) result.insert(uint32(value)); }
+            catch (...) { /* Invalid configuration never grants account access. */ }
+        }
+        return result;
+    }();
+    return accounts.count(accountId) != 0;
+}
+
+bool PlayerbotHolder::HasManagedLogins()
+{
+    std::lock_guard<std::mutex> lock(botLoginLeaseMutex);
+    for (auto const& entry : botLoginLeases)
+        if (auto lease = entry.second.lock()) if (lease->managed) return true;
+    return false;
+}
+
+bool PlayerbotHolder::IsManagedLogin(ObjectGuid guid)
+{
+    std::lock_guard<std::mutex> lock(botLoginLeaseMutex);
+    auto i = botLoginLeases.find(guid);
+    auto lease = i == botLoginLeases.end() ? nullptr : i->second.lock();
+    return lease && bool(lease->managed);
+}
